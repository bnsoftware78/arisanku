rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // penjual (Anda): akun yang punya dokumen owners/{uid}, dibuat manual lewat Firebase Console
    function isOwner() { return request.auth != null && exists(/databases/$(database)/documents/owners/$(request.auth.uid)); }
    // langganan pengurus harus aktif dan belum kedaluwarsa (dicek di server)
    function aktif() {
      return request.auth != null
        && get(/databases/$(database)/documents/pengurus/$(request.auth.uid)).data.status == 'aktif'
        && get(/databases/$(database)/documents/pengurus/$(request.auth.uid)).data.sampai > request.time;
    }
    // pemilik data = pengurus yang sedang login DAN langganannya aktif
    function own()  { return request.auth != null && resource.data.owner == request.auth.uid && aktif(); }
    function mine() { return request.auth != null && request.resource.data.owner == request.auth.uid && aktif(); }

    match /owners/{uid} { allow get: if request.auth != null && request.auth.uid == uid; allow write: if false; }
    match /pengurus/{uid} {
      allow get: if request.auth != null && (request.auth.uid == uid || isOwner());
      allow list: if isOwner();
      allow create: if request.auth != null && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['uid','email','nama','wa','status','at'])
                    && request.resource.data.uid == uid && request.resource.data.status == 'menunggu'
                    && request.resource.data.nama is string && request.resource.data.nama.size() < 100
                    && request.resource.data.wa is string && request.resource.data.wa.size() < 30;
      allow update, delete: if isOwner();
    }
    match /langganan/{id} { allow read, write: if isOwner(); }

    // Data admin: hanya bisa dibaca & diubah oleh pemiliknya
    match /grup/{id}    { allow read, delete: if own(); allow create: if mine(); allow update: if own() && mine(); }
    match /anggota/{id} { allow read, delete: if own(); allow create: if mine(); allow update: if own() && mine(); }
    match /setoran/{id} { allow read, delete: if own(); allow create: if mine(); allow update: if own() && mine(); }
    match /undian/{id}  { allow read, delete: if own(); allow create: if mine(); allow update: if own() && mine(); }

    // Halaman anggota (tanpa login): hanya bisa dibuka lewat tautan berisi token acak (get), tidak bisa di-list
    match /portal/{token} {
      allow get: if true;
      allow list: if false;
      allow create: if mine();
      allow update: if own() && mine();
      allow delete: if own();
    }

    // Bukti transfer kiriman anggota: siapa pun dengan token valid boleh MENGIRIM, hanya admin yang boleh membaca
    match /kiriman/{id} {
      allow create: if request.resource.data.keys().hasOnly(['owner','token','mid','gid','nama','v','tgl','m','bukti','status','at'])
                    && request.resource.data.status == 'baru'
                    && request.resource.data.v is number && request.resource.data.v > 0 && request.resource.data.v < 1000000000
                    && request.resource.data.nama is string && request.resource.data.nama.size() < 100
                    && request.resource.data.tgl is string && request.resource.data.tgl.size() == 10
                    && request.resource.data.m is string && request.resource.data.m.size() < 40
                    && request.resource.data.bukti is string && request.resource.data.bukti.size() < 400000
                    && exists(/databases/$(database)/documents/portal/$(request.resource.data.token))
                    && get(/databases/$(database)/documents/portal/$(request.resource.data.token)).data.owner == request.resource.data.owner;
      allow read, delete: if own();
      allow update: if own() && mine();
    }
  }
}
